{
  "name": "cortador",
  "version": "0.5.4",
  "description": "Cortador - corta modelos 3D para gran formato (by Brumet)",
  "author": "Brumet",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "motor": "python ../packaging/motor_embebido.py"
  },
  "build": {
    "appId": "com.brumet.cortador",
    "productName": "Cortador",
    "publish": [
      {
        "provider": "github",
        "owner": "Brumet",
        "repo": "Cortador"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cortador",
      "artifactName": "Cortador-Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "main.js",
      "espera.html",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "motor/",
        "to": "motor/",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
